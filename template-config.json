{
 "buckets": {},
 "services": {
  "b1c39543-8337-4d70-975f-58f6c173e594": {
   "icon": "https://raw.githubusercontent.com/two-workspaces/skillhub/main/icon.png",
   "name": "SkillHub",
   "build": {
    "dockerfilePath": "Dockerfile"
   },
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/nginx-health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "repo": "https://github.com/two-workspaces/skillhub",
    "rootDirectory": null
   },
   "networking": {
    "serviceDomains": {
     "<hasDomain>:80": {
      "port": 80
     }
    }
   },
   "volumeMounts": {},
   "variables": {
    "SKILLHUB_API_UPSTREAM": {
     "defaultValue": "http://${{server.RAILWAY_PRIVATE_DOMAIN}}:8080",
     "description": "Where nginx forwards /api - the server service on the private network",
     "isOptional": false
    },
    "SKILLHUB_PUBLIC_BASE_URL": {
     "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Public URL of this registry, used in the agent install guide",
     "isOptional": false
    },
    "SKILLHUB_TRUST_FORWARDED_PROTO": {
     "defaultValue": "true",
     "description": "Trust Railway's edge X-Forwarded-Proto so login cookies and redirects use https",
     "isOptional": false
    },
    "PORT": {
     "defaultValue": "80",
     "description": "nginx port behind the Railway domain - leave as is",
     "isOptional": false
    },
    "SKILLHUB_ALLOW_SIGNUP": {
     "defaultValue": "false",
     "description": "Let anyone with the URL create an account. Off by default: the admin creates accounts, or you set this to true and redeploy.",
     "isOptional": false
    }
   }
  },
  "0f851003-4e3b-4bdb-8b6f-e002f55af19f": {
   "icon": "https://raw.githubusercontent.com/two-workspaces/skillhub/main/icon.png",
   "name": "server",
   "build": {},
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "ghcr.io/iflytek/skillhub-server:v0.2.22"
   },
   "networking": {
    "serviceDomains": {}
   },
   "volumeMounts": {
    "629d0487-7a5c-4bba-9c8e-eec620bc9ba7": {
     "mountPath": "/var/lib/skillhub/storage"
    }
   },
   "variables": {
    "BOOTSTRAP_ADMIN_PASSWORD": {
     "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Password of the first admin account (username: admin). Only used when the account is first created - change it later in the UI.",
     "isOptional": false
    },
    "BOOTSTRAP_ADMIN_USERNAME": {
     "defaultValue": "admin",
     "description": "Username of the first admin account",
     "isOptional": false
    },
    "BOOTSTRAP_ADMIN_ENABLED": {
     "defaultValue": "true",
     "description": "Create the admin account on first boot",
     "isOptional": false
    },
    "BOOTSTRAP_ADMIN_EMAIL": {
     "defaultValue": "admin@skillhub.local",
     "description": "Email of the first admin account",
     "isOptional": false
    },
    "SKILLHUB_AUTH_INITIAL_SELF_REGISTRATION_ENABLED": {
     "defaultValue": "false",
     "description": "Whether anyone can sign up on first boot. Off so a public URL isn't an open registry; the admin can turn it on in the UI.",
     "isOptional": false
    },
    "SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Signs anonymous download rate-limit cookies",
     "isOptional": false
    },
    "SKILLHUB_PUBLIC_BASE_URL": {
     "defaultValue": "https://${{SkillHub.RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Public URL of the registry (the SkillHub web service)",
     "isOptional": false
    },
    "SESSION_COOKIE_SECURE": {
     "defaultValue": "true",
     "description": "Send the session cookie over https only",
     "isOptional": false
    },
    "SPRING_DATASOURCE_URL": {
     "defaultValue": "jdbc:postgresql://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
     "description": "Postgres connection",
     "isOptional": false
    },
    "SPRING_DATASOURCE_USERNAME": {
     "defaultValue": "${{Postgres.POSTGRES_USER}}",
     "description": "Postgres user",
     "isOptional": false
    },
    "SPRING_DATASOURCE_PASSWORD": {
     "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
     "description": "Postgres password",
     "isOptional": false
    },
    "SPRING_DATA_REDIS_HOST": {
     "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Redis host",
     "isOptional": false
    },
    "SPRING_DATA_REDIS_PORT": {
     "defaultValue": "6379",
     "description": "Redis port",
     "isOptional": false
    },
    "SPRING_DATA_REDIS_PASSWORD": {
     "defaultValue": "${{Redis.REDIS_PASSWORD}}",
     "description": "Redis password",
     "isOptional": false
    },
    "SKILLHUB_STORAGE_PROVIDER": {
     "defaultValue": "local",
     "description": "Skill packages are stored on this service's volume",
     "isOptional": false
    },
    "STORAGE_BASE_PATH": {
     "defaultValue": "/var/lib/skillhub/storage",
     "description": "Volume path for skill packages",
     "isOptional": false
    },
    "SKILLHUB_SECURITY_SCANNER_ENABLED": {
     "defaultValue": "true",
     "description": "Scan every uploaded skill with the scanner service before it is published",
     "isOptional": false
    },
    "SKILLHUB_SECURITY_SCANNER_URL": {
     "defaultValue": "http://${{scanner.RAILWAY_PRIVATE_DOMAIN}}:8000",
     "description": "Scanner service on the private network",
     "isOptional": false
    },
    "SKILLHUB_SECURITY_SCANNER_MODE": {
     "defaultValue": "upload",
     "description": "Send packages to the scanner over HTTP",
     "isOptional": false
    },
    "SKILLHUB_SUITE_REVIEW_WRITES_ENABLED": {
     "defaultValue": "true",
     "description": "Safe with a single server replica",
     "isOptional": false
    },
    "SKILLHUB_LOG_FORMAT": {
     "defaultValue": "json",
     "description": "Log format",
     "isOptional": false
    },
    "SKILLHUB_SERVICE_ENVIRONMENT": {
     "defaultValue": "production",
     "description": "Environment label",
     "isOptional": false
    },
    "JAVA_TOOL_OPTIONS": {
     "defaultValue": "-Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k",
     "description": "JVM memory caps. Without them the JVM sizes itself from the plan's RAM limit, not from what the registry needs. Raise -Xmx for many users or big uploads.",
     "isOptional": false
    },
    "RAILWAY_RUN_UID": {
     "defaultValue": "0",
     "description": "The image runs as a non-root user; Railway volumes are root-owned",
     "isOptional": false
    },
    "PORT": {
     "defaultValue": "8080",
     "description": "Server port - leave as is",
     "isOptional": false
    },
    "MALLOC_ARENA_MAX": {
     "defaultValue": "2",
     "description": "Fewer glibc malloc arenas - saves ~100 MB of RAM for the JVM",
     "isOptional": false
    }
   }
  },
  "ded164b2-0a64-4d65-8328-a4b728270439": {
   "icon": "https://raw.githubusercontent.com/two-workspaces/skillhub/main/icon.png",
   "name": "scanner",
   "build": {},
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "ghcr.io/iflytek/skillhub-scanner:v0.2.22"
   },
   "networking": {
    "serviceDomains": {}
   },
   "volumeMounts": {},
   "variables": {
    "SKILLHUB_SCANNER_MAX_CONCURRENT_SCANS": {
     "defaultValue": "1",
     "description": "Scans running at once",
     "isOptional": false
    },
    "SKILL_SCANNER_LLM_API_KEY": {
     "defaultValue": "",
     "description": "Optional: API key for the scanner's LLM analyzer",
     "isOptional": true
    },
    "SKILL_SCANNER_LLM_MODEL": {
     "defaultValue": "",
     "description": "Optional: model for the scanner's LLM analyzer",
     "isOptional": true
    },
    "SKILL_SCANNER_LLM_BASE_URL": {
     "defaultValue": "",
     "description": "Optional: base URL for an OpenAI-compatible LLM endpoint",
     "isOptional": true
    },
    "PORT": {
     "defaultValue": "8000",
     "description": "Scanner port - leave as is",
     "isOptional": false
    }
   }
  },
  "8a5a8768-4373-4cd4-ac36-bb239b0b383b": {
   "icon": "https://devicons.railway.app/i/postgresql.svg",
   "name": "Postgres",
   "build": {},
   "deploy": {
    "startCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "postgres:16.15-alpine"
   },
   "networking": {
    "serviceDomains": {}
   },
   "volumeMounts": {
    "b636d9f5-d685-4a9b-b557-36351a4d0117": {
     "mountPath": "/var/lib/postgresql/data"
    }
   },
   "variables": {
    "POSTGRES_DB": {
     "defaultValue": "skillhub",
     "description": "Database name",
     "isOptional": false
    },
    "POSTGRES_USER": {
     "defaultValue": "skillhub",
     "description": "Database user",
     "isOptional": false
    },
    "POSTGRES_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Auto-generated database password",
     "isOptional": false
    },
    "PGDATA": {
     "defaultValue": "/var/lib/postgresql/data/pgdata",
     "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
     "isOptional": false
    },
    "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
     "defaultValue": "60",
     "description": "Time for Postgres to shut down cleanly on redeploy",
     "isOptional": false
    }
   }
  },
  "a6effc69-390d-4a5a-afb9-dd93e23df4d1": {
   "icon": "https://devicons.railway.app/i/redis.svg",
   "name": "Redis",
   "build": {},
   "deploy": {
    "startCommand": "/bin/sh -c \"chown -R redis:redis /data && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --appendonly yes\"",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "redis:8.10.2-alpine"
   },
   "networking": {
    "serviceDomains": {}
   },
   "volumeMounts": {
    "7f3e1a14-cb84-423e-9edd-940d36b9a801": {
     "mountPath": "/data"
    }
   },
   "variables": {
    "REDIS_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Auto-generated Redis password",
     "isOptional": false
    }
   }
  }
 }
}